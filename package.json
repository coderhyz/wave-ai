{
  "name": "wave-ai",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:all": "concurrently --kill-others --names web,worker \"npm:dev\" \"npm:worker:documents\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "worker:documents": "node --env-file=.env --conditions=react-server --import tsx workers/document-worker.ts",
    "reindex:documents": "node --env-file=.env --conditions=react-server --import tsx workers/reindex-documents.ts",
    "purge:knowledge": "node --env-file=.env --conditions=react-server --import tsx workers/purge-deleted-knowledge.ts",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:studio": "npx prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.54",
    "@ai-sdk/deepseek": "^3.0.52",
    "@ai-sdk/gateway": "^4.0.91",
    "@ai-sdk/react": "^4.0.116",
    "@base-ui/react": "^1.5.0",
    "@elastic/elasticsearch": "^8.19.2",
    "@hono/zod-validator": "^0.7.2",
    "@hookform/resolvers": "^5.4.0",
    "@iamjariwala/react-doc-viewer": "1.9.0",
    "@langchain/textsplitters": "^1.0.2",
    "@lobehub/icons": "4.12.0",
    "@lobehub/ui": "4.38.4",
    "@prisma/client": "^6.14.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@remixicon/react": "^4.6.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-virtual": "^3.13.12",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "ai": "^7.0.113",
    "ali-oss": "^6.23.0",
    "antd": "6.6.5",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.1.0",
    "hono": "^4.9.4",
    "iconv-lite": "^0.7.3",
    "jszip": "3.10.2",
    "lucide-react": "^1.47.0",
    "mammoth": "1.13.0",
    "motion": "^13.4.1",
    "nanoid": "^6.0.1",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "nuqs": "^2.5.2",
    "pdf-parse": "2.4.5",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.76.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^11.1.0",
    "yauzl": "3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "mammoth": {
      "argparse": "2.0.1"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "5.0.6",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^6.14.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
